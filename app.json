{
  "id": "nl.vanvoorkes.connectlife-airco",
  "version": "0.1.0",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "ConnectLife Airco (personal)",
    "nl": "ConnectLife Airco (persoonlijk)"
  },
  "description": {
    "en": "Personal, unofficial ConnectLife air conditioner control (Hisense AEH-W4G2 modules).",
    "nl": "Persoonlijke, onofficiële ConnectLife-airco-aansturing (Hisense AEH-W4G2-modules)."
  },
  "category": [
    "climate"
  ],
  "permissions": [],
  "author": {
    "name": "Jo Van Vooren"
  },
  "brandColor": "#00A0B0",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "capabilities": {
    "connectlife_eco": {
      "type": "boolean",
      "title": {
        "en": "Eco mode",
        "nl": "Eco-stand"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle"
    },
    "connectlife_fan": {
      "type": "enum",
      "title": {
        "en": "Fan speed",
        "nl": "Ventilatorsnelheid"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        {
          "id": "auto",
          "title": {
            "en": "Auto",
            "nl": "Auto"
          }
        },
        {
          "id": "low",
          "title": {
            "en": "Low",
            "nl": "Laag"
          }
        },
        {
          "id": "middle_low",
          "title": {
            "en": "Medium low",
            "nl": "Middel laag"
          }
        },
        {
          "id": "medium",
          "title": {
            "en": "Medium",
            "nl": "Middel"
          }
        },
        {
          "id": "middle_high",
          "title": {
            "en": "Medium high",
            "nl": "Middel hoog"
          }
        },
        {
          "id": "high",
          "title": {
            "en": "High",
            "nl": "Hoog"
          }
        }
      ]
    },
    "connectlife_mode": {
      "type": "enum",
      "title": {
        "en": "Mode",
        "nl": "Modus"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        {
          "id": "auto",
          "title": {
            "en": "Auto",
            "nl": "Auto"
          }
        },
        {
          "id": "cool",
          "title": {
            "en": "Cool",
            "nl": "Koelen"
          }
        },
        {
          "id": "heat",
          "title": {
            "en": "Heat",
            "nl": "Verwarmen"
          }
        },
        {
          "id": "dry",
          "title": {
            "en": "Dry",
            "nl": "Ontvochtigen"
          }
        },
        {
          "id": "fan_only",
          "title": {
            "en": "Fan only",
            "nl": "Enkel ventilator"
          }
        }
      ]
    }
  },
  "drivers": [
    {
      "name": {
        "en": "ConnectLife air conditioner",
        "nl": "ConnectLife airco"
      },
      "class": "thermostat",
      "capabilities": [
        "onoff",
        "target_temperature",
        "measure_temperature",
        "connectlife_mode",
        "connectlife_fan",
        "connectlife_eco"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 16,
          "max": 32,
          "step": 1
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "images": {
        "small": "/drivers/airco/assets/images/small.png",
        "large": "/drivers/airco/assets/images/large.png",
        "xlarge": "/drivers/airco/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "airco"
    }
  ]
}