{
  "name": { "en": "ConnectLife air conditioner", "nl": "ConnectLife airco" },
  "class": "thermostat",
  "capabilities": [
    "onoff",
    "target_temperature",
    "measure_temperature",
    "connectlife_mode",
    "connectlife_fan",
    "connectlife_eco"
  ],
  "capabilitiesOptions": {
    "target_temperature": { "min": 16, "max": 32, "step": 1 }
  },
  "platforms": ["local"],
  "connectivity": ["cloud"],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    { "id": "login_credentials", "template": "login_credentials" },
    { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } },
    { "id": "add_devices", "template": "add_devices" }
  ]
}
